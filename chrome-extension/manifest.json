{
  "manifest_version": 3,
  "name": "Parano1d World",
  "short_name": "Parano1d",
  "version": "2.5.3",
  "description": "Your Parano1d wallet in Chrome's side panel. Connected sites see only addresses you choose, and you approve every signature.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Parano1d World",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://parano1dworld.com/*",
    "https://www.parano1dworld.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://parano1dworld.com/*",
        "https://www.parano1dworld.com/*"
      ],
      "js": [
        "link.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "inpage.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
  },
  "minimum_chrome_version": "116",
  "side_panel": {
    "default_path": "popup.html?view=panel"
  }
}
